[Unit]
Description=PulseAudio system instance with mc null sink (drives MC->ffmpeg audio path)
After=network.target

[Service]
Type=simple
PrivateTmp=true
RuntimeDirectory=pulse
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/pulseaudio --system --disallow-module-loading=false --disallow-exit=true --disable-shm=false --exit-idle-time=-1 --log-target=journal --high-priority=true --realtime=true   --load="module-native-protocol-unix auth-anonymous=1 socket=/var/run/pulse/native"   --load="module-null-sink sink_name=mc sink_properties=device.description=mc-bot-sink"   --load="module-suspend-on-idle"
ExecStartPost=/bin/sh -c "sleep 1 && /usr/bin/pactl --server=unix:/var/run/pulse/native list short sinks >/dev/null"
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
