[Unit]
Description=sleet1213 MC chat bridge (btone SSE → webhook)
After=network-online.target sleet1213-webhook.service
Requires=sleet1213-webhook.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/sleet1213
EnvironmentFile=/home/ubuntu/sleet1213/.env
ExecStart=/usr/bin/node --loader ts-node/esm src/mc-bridge.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
