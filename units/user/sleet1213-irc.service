[Unit]
Description=sleet1213 IRC bridge (Twitch chat in/out)
After=network-online.target sleet1213-webhook.service
Requires=sleet1213-webhook.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/twitch-mc/apps/sleet1213
EnvironmentFile=/home/ubuntu/twitch-mc/apps/sleet1213/.env
ExecStart=/usr/bin/node --loader ts-node/esm src/irc-bridge.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
