[Unit]
Description=Temporal dev server (sleet1213)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/ubuntu/.temporalio/bin/temporal server start-dev --ip 127.0.0.1 --port 7233 --ui-port 8233 --db-filename /home/ubuntu/sleet1213/.temporal-db
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
